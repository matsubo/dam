# syntax=docker/dockerfile:1.7
# Build the Next.js (App Router) web app for production.
# Multi-stage so the final image only carries the runtime, not the build toolchain.

FROM oven/bun:1.3 AS deps
WORKDIR /app

# Workspace manifests + lockfile first to maximize Docker layer caching.
# `bun install` only re-runs when one of these files changes.
COPY package.json bun.lock tsconfig.base.json biome.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/ingest/package.json packages/ingest/package.json
COPY packages/reconciler/package.json packages/reconciler/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/adapters/damnet/package.json packages/adapters/damnet/package.json
COPY packages/adapters/kasenbosai/package.json packages/adapters/kasenbosai/package.json
COPY packages/adapters/ndi/package.json packages/adapters/ndi/package.json
COPY packages/adapters/suimon/package.json packages/adapters/suimon/package.json

RUN bun install --frozen-lockfile

# ---------------------------------------------------------------------------
FROM deps AS build
WORKDIR /app

# Copy the workspace packages the web app depends on transitively.
# Keep this list aligned with apps/web/package.json `dependencies`.
COPY packages ./packages
COPY apps/web ./apps/web

WORKDIR /app/apps/web
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun next build

# ---------------------------------------------------------------------------
FROM oven/bun:1.3 AS run
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

# Bring over the resolved node_modules + the built app + workspace packages.
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/package.json /app/package.json
COPY --from=build /app/bun.lock /app/bun.lock
COPY --from=build /app/packages /app/packages
COPY --from=build /app/apps/web /app/apps/web
# Bundle the master-data seed (gzipped pg_dump of dams + watersheds + sources +
# rivers — 16 MB compressed). Restored on first boot if `dams` is empty.
COPY deploy/seed/master.sql.gz /seed/master.sql.gz
# Idempotent UPSERT bundle (matches by external_ids->>'ndi'). Applied on
# every boot — converges prod's master rows to the bundled snapshot without
# touching observations/raw_snapshots/match_review.
COPY deploy/seed/master_upsert.sql.gz /seed/master_upsert.sql.gz
# postgresql-client gives us psql for the seed restore. Tiny on debian-slim.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/*

WORKDIR /app/apps/web
EXPOSE 3000

# Healthcheck — Coolify will also do its own, but having one in the image
# makes `docker compose` self-healing locally. The `oven/bun` image has no
# curl/wget, so we use bun's built-in fetch.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:3000/api/v1/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

# Bootstrap chain on every container start:
#   1. Apply any pending migrations  (idempotent via _migrations ledger)
#   2. If the dams table is empty, restore the bundled master seed.
#      The seed is a pg_dump --data-only of dams + watersheds + rivers +
#      source_priorities, ~16 MB gzipped, baked into the image at /seed/.
#   3. If observations is empty AND dams is now populated, run the synthetic
#      observation seeder so the chart endpoints have plausible data.
#   4. Start Next.js.
COPY deploy/coolify/bootstrap.sh /bootstrap.sh
RUN chmod +x /bootstrap.sh
CMD ["/bootstrap.sh"]
