#!/bin/sh
# pre-push: run unit tests across apps + packages. E2E (Playwright) is
# excluded — too slow for a push hook; runs in CI / on demand only.
#
# Wired via git config core.hooksPath .githooks (set by `bun run prepare`
# at install time). Bypass with --no-verify when intentionally pushing
# WIP commits.

set -e

echo "[pre-push] bun test"

# Probe the local DB. Integration tests (repo/, pipeline, reconciler, storage,
# adapter importers, API routes) require a live PostgreSQL + MinIO instance.
# When the local DB is not up, skip those paths so unit tests still gate the push.
#
# Where the connection details come from, highest precedence first:
#
#   1. DATABASE_HOST / DATABASE_PORT in the environment — explicit override.
#   2. DATABASE_URL, from the environment or, failing that, the repo-root .env.
#   3. localhost:5433 — the historical default.
#
# Step 2 matters because this hook runs under /bin/sh, which does NOT read
# .env — only `bun` does. Without it, a worktree that shifts its port (the
# per-worktree convention, e.g. DB_PORT=5435 to keep Docker projects from
# colliding) probes 5433, finds nothing, and silently drops ~140 integration
# tests from the push gate even though its database is up.
DB_URL="${DATABASE_URL:-}"
if [ -z "${DB_URL}" ]; then
  ENV_FILE="$(git rev-parse --show-toplevel 2>/dev/null)/.env"
  if [ -f "${ENV_FILE}" ]; then
    # First DATABASE_URL assignment wins; tolerate `export `, surrounding
    # quotes and trailing whitespace. Nothing is eval'd — the value is only
    # ever parsed for a host and a port below.
    DB_URL=$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}DATABASE_URL[[:space:]]*=[[:space:]]*//p' \
      "${ENV_FILE}" | head -n 1 | sed -e 's/^"//' -e "s/^'//" -e 's/"[[:space:]]*$//' -e "s/'[[:space:]]*\$//" -e 's/[[:space:]]*$//')
  fi
fi

# postgres://[user[:pass]@]host[:port][/db] → host, port. An absent port means
# the Postgres default; an unparseable URL leaves both empty and we fall back.
URL_AUTHORITY=$(printf '%s' "${DB_URL}" | sed -n 's|^[a-zA-Z][a-zA-Z0-9+.-]*://||p' | sed -e 's|[/?].*$||' -e 's|^.*@||')
URL_HOST=$(printf '%s' "${URL_AUTHORITY}" | sed -e 's|:[0-9]*$||')
URL_PORT=$(printf '%s' "${URL_AUTHORITY}" | sed -n 's|^.*:\([0-9]\{1,\}\)$|\1|p')
[ -n "${URL_HOST}" ] && [ -z "${URL_PORT}" ] && URL_PORT=5432

DB_HOST="${DATABASE_HOST:-${URL_HOST:-localhost}}"
DB_PORT="${DATABASE_PORT:-${URL_PORT:-5433}}"

if nc -z "$DB_HOST" "$DB_PORT" 2>/dev/null; then
  # Never test against the dev database itself: leftover rows and another
  # worktree's concurrent suite (same fixture IDs) both produce phantom
  # failures. Run in a fresh per-worktree scratch database instead.
  BASE_URL="${DB_URL:-postgres://dam:dam@${DB_HOST}:${DB_PORT}/dam}"
  DATABASE_URL=$(bun run bin/test_db.ts "${BASE_URL}" "$(git rev-parse --show-toplevel)")
  export DATABASE_URL
  echo "[pre-push] scratch DB: ${DATABASE_URL##*/}"
  bun run --filter @dam/db migrate > /dev/null
  (cd apps/worker && bunx graphile-worker --schema-only > /dev/null)
  exec bun test apps packages
else
  echo "[pre-push] No DB at ${DB_HOST}:${DB_PORT} — skipping integration tests"
  # Every path below needs a live PostgreSQL. The list is deliberately
  # file-precise rather than directory-wide: apps/worker/src/tasks holds 63
  # test files and only 3 of them touch the DB, so ignoring the whole
  # directory would drop ~60 pure parser tests out of the push gate.
  #
  # To regenerate after adding a DB-backed test (run from the repo root with
  # the DB *down*, or pointed at a dead port as below) — any file listed in
  # the output that is not already ignored here must be added:
  #
  #   DATABASE_URL='postgres://dam:dam@127.0.0.1:59999/dam' \
  #     bun test apps packages > /tmp/nodb.log 2>&1
  #   awk '/^(apps|packages)\/.*\.test\.ts:/ {f=$0} /^\(fail\)/ {print f}' \
  #     /tmp/nodb.log | sort -u
  exec bun test apps packages \
    --path-ignore-patterns "packages/db/src/repo/**" \
    --path-ignore-patterns "packages/ingest/**" \
    --path-ignore-patterns "packages/reconciler/**" \
    --path-ignore-patterns "packages/storage/**" \
    --path-ignore-patterns "packages/adapters/damnet/**" \
    --path-ignore-patterns "packages/adapters/ndi/**" \
    --path-ignore-patterns "apps/web/app/api/**" \
    --path-ignore-patterns "apps/web/lib/api/**" \
    --path-ignore-patterns "apps/web/app/watersheds/locate/route.test.ts" \
    --path-ignore-patterns "apps/worker/src/tasks/aggregates_refresh.test.ts" \
    --path-ignore-patterns "apps/worker/src/tasks/match_kasenbosai.test.ts" \
    --path-ignore-patterns "apps/worker/src/tasks/quality_recompute.test.ts"
fi
