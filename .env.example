# Database
DATABASE_URL=postgres://dam:dam@localhost:5432/dam

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dam-raw
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Worker
WORKER_CONCURRENCY=4

# Web
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Advertising (Google AdSense) — leave UNSET to run the site completely ad-free.
# When unset: <AdSlot /> renders nothing, /ads.txt 404s, and the privacy policy
# omits its advertising clause. Setting these is the single switch that turns
# advertising on.
#
# 広告を出すルートは apps/web/lib/ad-eligibility.ts が deny-by-default で管理します
# (現在: /dams/<slug> のダム貯水率ページ、/glossary、/roadmap)。
#
# ⚠️ AdSense 管理画面の「自動広告」は必ず OFF に。GTM コンテナ経由で AdSense タグを
#    入れるのも同様に NG。どちらも ad-eligibility.ts を素通りして全ページに広告が入ります。
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=0000000000
